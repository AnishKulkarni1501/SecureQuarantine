# Local development only. Use unique secrets and restrict database access in deployments.
APP_ENV=development
DATABASE_URL=sqlite:///./securequarantine.db
ARTIFACT_DIR=./data/artifacts
MAX_UPLOAD_BYTES=52428800

# Production authentication: set APP_ENV=production and generate long random values.
ANALYST_API_TOKEN=replace-with-a-long-random-analyst-token
REVIEWER_API_TOKEN=replace-with-a-different-long-random-reviewer-token

# Optional data services (bring up with: docker compose up -d mysql mongo redis)
# DATABASE_URL=mysql+pymysql://sq_app:local-dev-password@127.0.0.1:3307/securequarantine
MONGO_URI=mongodb://127.0.0.1:27018
MONGO_DATABASE=securequarantine
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Optional analysis workers. Set only to trusted, separately isolated services.
GHIDRA_WORKER_URL=
LLM4DECOMPILE_URL=
ZYSEC_INTERPRETER_URL=
SANDBOX_WORKER_URL=
SANDBOX_WORKER_TOKEN=
SANDBOX_MODE=hardened_vm
SANDBOX_ISOLATION_ATTESTED=false
SANDBOX_DOCKER_CONTAINMENT_ACK=false
SANDBOX_DOCKER_IMAGE=securequarantine/elf-sandbox:0.1
